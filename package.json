{
  "name": "baudroie-signature-lp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "qa": "python3 scripts/visual_qa.py",
    "build:pages": "tsc --noEmit && vite build --base=/baudroieLP_shomei/ && node scripts/prepare-pages.mjs",
    "build:engineer-preview": "tsc --noEmit && node scripts/build-engineer-preview.mjs",
    "build:approved-preview": "tsc --noEmit && node scripts/build-approved-preview.mjs",
    "preview:approved": "vite preview --outDir approved-dist --base=/approved-four-pages/ --host 127.0.0.1 --port 4192"
  },
  "dependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
